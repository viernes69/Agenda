:root {
  --bg: #0f1115;
  --panel: #151922;
  --muted: #9aa4b2;
  --text: #e6e8eb;
  --accent: #8b5cf6;
  --accent-600: #7c3aed;
  --border: #222736;
  --success: #22c55e;
  --success-dark: #16a34a;
}

* { box-sizing: border-box; }
html, body { height: 100%; }
body {
  margin: 0;
  font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.container { width: min(1100px, 92%); margin-inline: auto; }
.section { padding: 2.5rem 0; }
.section-head { margin-bottom: 1rem; }
.section-head h2 { margin: 0; font-size: 1.6rem; font-weight: 600; }

.muted { color: var(--muted); }

.site-header {
  position: sticky; top: 0; z-index: 10;
  background: rgba(15,17,21,0.7);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border);
}
.header-inner {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.9rem 0;
}
.brand { display: flex; align-items: center; gap: .6rem; font-weight: 600; }
.brand .title { letter-spacing: .2px; }
.brand span.logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: .9rem;
  background: rgba(139, 92, 246, 0.18);
  color: #f8fafc;
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: .05em;
  text-transform: uppercase;
  box-shadow: 0 8px 24px rgba(139, 92, 246, 0.24);
}
.brand img.logo {
  display: block;
  height: 40px;
  width: auto;
  max-width: 160px;
  padding: .3rem .6rem;
  border-radius: .9rem;
  background: rgba(15, 23, 42, 0.65);
  border: 1px solid rgba(139, 92, 246, 0.35);
  box-shadow: 0 10px 28px rgba(10, 12, 18, 0.55);
  object-fit: contain;
}
.nav { display: flex; gap: .8rem; align-items: center; }
.nav a { color: var(--text); text-decoration: none; padding: .5rem .7rem; border-radius: .5rem; }
.nav a:hover { background: var(--panel); }

.hero { padding: 3rem 0 1.5rem; text-align: center; }
.hero h1 { margin: 0 0 .6rem; font-size: clamp(1.8rem, 2.5vw + 1rem, 2.6rem); }
.hero p { margin: 0 0 1rem; color: var(--muted); }

.btn {
  display: inline-block; cursor: pointer; border: 1px solid transparent;
  border-radius: .6rem; padding: .6rem .9rem; font-weight: 600; color: var(--text);
  text-decoration: none; transition: background .15s ease, border-color .15s ease, color .15s ease;
}
.btn-accent { background: var(--accent); color: white; }
.btn-accent:hover { background: var(--accent-600); }
.btn-outline { background: transparent; border-color: var(--border); color: var(--text); }
.btn-outline:hover { border-color: var(--accent); color: var(--accent); }
.btn-success { background: var(--success); border-color: var(--success); color: #0f1115; }
.btn-success:hover { background: var(--success-dark); border-color: var(--success-dark); color: white; }
.btn:disabled { opacity: .5; pointer-events: none; cursor: not-allowed; }

.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1rem;
}
.card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: .9rem;
  overflow: hidden;
  display: flex; flex-direction: column;
}
.card-media { aspect-ratio: 16/9; background: #0c0e13; display:flex; align-items:center; justify-content:center; }
.card-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
.placeholder { color: var(--muted); font-size: .9rem; }
.card-body { padding: .9rem; display: grid; gap: .6rem; }
.card-title { margin: 0; font-size: 1.05rem; }
.meta { display: flex; gap: .6rem; color: var(--muted); font-size: .9rem; }

/* Carousel */
.carousel { position: relative; display: grid; align-items: center; grid-template-columns: auto 1fr auto; gap: .5rem; }
.carousel-btn {
  width: 42px; height: 42px; display: grid; place-items: center;
  background: var(--panel); color: var(--text); border: 1px solid var(--border);
  border-radius: .7rem; cursor: pointer;
}
.carousel-btn:hover { border-color: var(--accent); color: var(--accent); }
.carousel-track {
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  display: grid; grid-auto-flow: column; grid-auto-columns: minmax(240px, 300px);
  gap: 1rem; padding: .2rem; scroll-behavior: smooth;
}
.slide {
  scroll-snap-align: start;
  background: var(--panel); border: 1px solid var(--border); border-radius: .9rem; overflow: hidden;
  display: flex; flex-direction: column; min-height: 100%;
}
.slide-media { aspect-ratio: 16/9; background: #0c0e13; display:flex; align-items:center; justify-content:center; }
.slide-media img { width: 100%; height: 100%; object-fit: cover; display:block; }
.slide-body { padding: .9rem; display: grid; gap: .5rem; }
.slide-title { margin: 0; font-size: 1.05rem; }
.slide-meta { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font-size: .9rem; }
.chip { background: #1c2030; color: #cbd5e1; padding: .2rem .5rem; border-radius: .5rem; border: 1px solid var(--border); }
.price { color: #dbeafe; font-weight: 600; }
.slide-desc { margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.35; max-height: 3.5em; overflow: hidden; }

.slide-perk {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  margin-top: .65rem;
  font-size: .9rem;
  color: #c0cad7;
}

.slide-perk i {
  font-size: 1rem;
}

.site-footer { border-top: 1px solid var(--border); padding: 2rem 0; color: var(--muted); }
.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1.2rem;
}
.modal__dialog--lg {
  width: min(640px, 92vw);
}
.footer-copy { margin: 0; }
.footer-links {
  display: flex;
  align-items: center;
  gap: .8rem 1rem;
  flex-wrap: wrap;
}
.footer-socials {
  display: flex;
  align-items: center;
  gap: .6rem;
  flex-wrap: wrap;
}
.footer-social {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  padding: .45rem .75rem;
  border-radius: .7rem;
  border: 1px solid rgba(148, 163, 184, 0.25);
  background: rgba(15, 23, 42, 0.65);
  color: var(--text);
  text-decoration: none;
  font-size: .94rem;
  transition: border-color .15s ease, color .15s ease, background .15s ease;
}
.footer-social:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: rgba(139, 92, 246, 0.12);
}
.footer-link {
  background: transparent;
  border: 1px solid rgba(148, 163, 184, 0.25);
  color: var(--text);
  padding: .45rem .75rem;
  border-radius: .7rem;
  font-size: .94rem;
  cursor: pointer;
  transition: border-color .15s ease, color .15s ease, box-shadow .15s ease;
}
.footer-link:hover {
  border-color: var(--accent);
  color: var(--accent);
}
.footer-link:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.25);
}

/* Responsive tweaks */
@media (max-width: 720px) {
  .nav { gap: .2rem; }
  .nav a { padding: .4rem .5rem; font-size: .95rem; }
  .carousel-btn { width: 38px; height: 38px; }
  .barber-grid {
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 1.2rem;
  }
  .barber-card__avatar {
    width: 88px;
    height: 88px;
  }
  .barber-modal__avatar {
    width: 96px;
    height: 96px;
  }
  .footer-inner {
    flex-direction: column;
    align-items: flex-start;
    gap: .9rem;
  }
  .footer-links {
    width: 100%;
    justify-content: flex-start;
  }
}

/* Horarios */
.schedule-controls {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  align-items: flex-end;
  margin-bottom: 1.5rem;
}
.schedule-controls label {
  display: flex;
  flex-direction: column;
  gap: .4rem;
  font-size: .95rem;
  color: var(--muted);
}
.schedule-controls input,
.schedule-controls select {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: .6rem;
  color: var(--text);
  padding: .55rem .75rem;
  min-width: 190px;
  font-size: 1rem;
  color-scheme: dark;
}
.schedule-controls input:focus,
.schedule-controls select:focus {
  outline: none;
  border-color: var(--accent);
}
.schedule-controls input::-webkit-calendar-picker-indicator {
  filter: invert(0.85);
}

.schedule-results {
  display: grid;
  gap: 1.2rem;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  justify-items: center;
  align-items: start;
}

.schedule-status {
  padding: 1.2rem;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: .9rem;
  text-align: center;
  color: var(--muted);
  font-size: .95rem;
}
.schedule-status--loading {
  color: #e0e7ff;
}
.schedule-status--error {
  border-color: rgba(239, 68, 68, 0.35);
  color: #fecaca;
}

.schedule-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 1rem;
  padding: 1.1rem 1.2rem;
  display: grid;
  gap: .8rem;
}
.schedule-card__head h3 {
  margin: 0;
  font-size: 1.1rem;
}
.schedule-card__turns {
  margin: 0;
  color: var(--muted);
  font-size: .9rem;
}
.schedule-card__slots {
  display: flex;
  flex-wrap: wrap;
  gap: .6rem;
}
.schedule-card__slots-empty {
  margin: 0;
  color: var(--muted);
  font-size: .92rem;
}

.barber-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 1.6rem;
  margin-top: 1.6rem;
  justify-items: center;
}
.barber-card {
  display: grid;
  gap: .45rem;
  justify-items: center;
  padding: 0;
  border: none;
  background: transparent;
  cursor: pointer;
  color: var(--text);
  text-decoration: none;
}
.barber-card__body {
  display: grid;
  gap: .35rem;
  justify-items: center;
}
.barber-card:focus-visible {
  outline: none;
}
.barber-card__avatar {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  padding: 4px;
  background: conic-gradient(#f09433, #e6683c, #dc2743, #cc2366, #bc1888, #f09433);
  display: grid;
  place-items: center;
  transition: transform .18s ease, box-shadow .18s ease;
}
.barber-card__avatar-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--panel);
  display: grid;
  place-items: center;
  font-weight: 600;
  font-size: 1.35rem;
  text-transform: uppercase;
  color: var(--text);
  transition: background .2s ease, color .2s ease, transform .2s ease, box-shadow .2s ease;
  animation: barber-pulse 3.2s ease-in-out infinite;
}
.barber-card__avatar-inner.has-image {
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
  color: transparent;
}
.barber-card:hover .barber-card__avatar,
.barber-card:focus-visible .barber-card__avatar {
  transform: translateY(-4px) scale(1.08);
  box-shadow: 0 14px 30px rgba(17, 24, 39, 0.35);
}

@keyframes barber-pulse {
  0% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(139, 92, 246, 0.0);
  }
  50% {
    transform: scale(1.04);
    box-shadow: 0 0 0 6px rgba(139, 92, 246, 0.15);
  }
  100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(139, 92, 246, 0.0);
  }
}
.barber-card__name {
  font-weight: 600;
  font-size: .94rem;
  text-align: center;
}
.barber-card__turns {
  margin: 0;
  font-size: .78rem;
  color: var(--muted);
  text-align: center;
}
.barber-card__actions {
  display: flex;
  justify-content: center;
  width: 100%;
  margin-top: .25rem;
  position: relative;
  z-index: 1;
}
.barber-card__cta {
  min-width: 120px;
  border-radius: 999px;
  background: linear-gradient(120deg, #22c55e, #16a34a);
  color: #05130a;
  font-weight: 700;
  border: 0;
  padding: .45rem 1rem;
  font-size: .85rem;
  box-shadow: 0 8px 18px rgba(34, 197, 94, 0.35);
  transition: transform .15s ease, box-shadow .15s ease, filter .15s ease;
  animation: reserve-pulse 4s ease-in-out infinite;
}
.barber-card__cta:hover,
.barber-card__cta:focus-visible {
  outline: none;
  transform: translateY(-1px);
  box-shadow: 0 12px 26px rgba(34, 197, 94, 0.45);
  filter: brightness(1.05);
}
@keyframes reserve-pulse {
  0% {
    transform: translateY(0) scale(1);
    box-shadow: 0 8px 18px rgba(34, 197, 94, 0.35);
  }
  50% {
    transform: translateY(0) scale(1.03);
    box-shadow: 0 14px 30px rgba(34, 197, 94, 0.45);
  }
  100% {
    transform: translateY(0) scale(1);
    box-shadow: 0 8px 18px rgba(34, 197, 94, 0.35);
  }
}
.barber-card__avatar-button {
  background: transparent;
  border: none;
  padding: 0;
  cursor: pointer;
}
.barber-card__slots {
  display: flex;
  flex-wrap: wrap;
  gap: .5rem;
  justify-content: center;
}
.barber-card__badge {
  margin-top: .1rem;
  padding: .12rem .5rem;
  border-radius: 999px;
  font-size: .7rem;
  font-weight: 600;
  background: rgba(34, 197, 94, 0.14);
  color: var(--success);
}
.barber-card__badge--empty {
  background: rgba(239, 68, 68, 0.16);
  color: #fca5a5;
}

.slot-pill {
  background: rgba(34, 197, 94, 0.15);
  border: 1px solid rgba(34, 197, 94, 0.55);
  border-radius: 999px;
  color: #bbf7d0;
  font-weight: 600;
  font-size: .9rem;
  padding: .45rem .9rem;
  cursor: pointer;
  transition: transform .12s ease, box-shadow .12s ease, background .12s ease;
}
.slot-pill:hover {
  background: rgba(34, 197, 94, 0.25);
  box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.15);
  transform: translateY(-1px);
}
.slot-pill.is-selected {
  background: var(--success);
  border-color: var(--success-dark);
  color: #0f172a;
  box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.25);
}

.schedule-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  margin-top: 1.5rem;
  padding: .85rem 1.5rem;
  border-radius: .9rem;
  border: 1px solid #16a34a;
  background: #16a34a; /* verde más intenso */
  color: #ffffff;
  font-weight: 700;
  font-size: 1rem;
  transition: transform .12s ease, box-shadow .12s ease, opacity .12s ease, background .12s ease;
  cursor: pointer;
}
.schedule-cta:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 12px 32px rgba(22, 163, 74, 0.35);
  background: #15803d; /* hover más profundo */
  border-color: #15803d;
}
.schedule-cta:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

[data-modal-root] {
  position: relative;
}
.modal {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  z-index: 40;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity .2s ease, visibility 0s linear .2s;
}
.modal.is-visible {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition-delay: 0s;
}
.modal.is-visible.is-closing {
  opacity: 0;
  pointer-events: none;
}
.modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(15, 17, 21, 0.72);
  backdrop-filter: blur(6px);
  opacity: 0;
  transition: opacity .18s ease;
}
.modal.is-visible .modal__backdrop {
  opacity: 1;
}
.modal.is-visible.is-closing .modal__backdrop {
  opacity: 0;
}
.modal__dialog {
  position: relative;
  z-index: 1;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 1rem;
  padding: clamp(1.2rem, 2vw, 1.5rem);
  width: min(400px, 92vw);
  display: grid;
  grid-template-rows: auto 1fr;
  gap: 1.2rem;
  box-shadow: 0 24px 52px rgba(0, 0, 0, 0.35);
  transform: translateY(-14px) scale(0.84, 0.72);
  opacity: 0;
  transform-origin: top center;
  will-change: transform, opacity;
  max-height: min(82vh, 680px);
}
.modal__dialog--barber {
  width: min(450px, 94vw);
  gap: 1rem;
  padding: clamp(1.15rem, 3vw, 1.45rem);
}
.modal__dialog--sm {
  width: min(360px, 90vw);
  padding: clamp(1rem, 2.5vw, 1.25rem);
}
@media (max-width: 640px) {
  .modal {
    align-items: center;
    justify-items: center;
    padding: clamp(.6rem, 3vw, 1.2rem);
  }
  .modal__dialog,
  .modal__dialog--barber,
  .modal__dialog--lg {
    width: min(100vw - clamp(1rem, 5vw, 2rem), 420px);
    max-width: none;
    height: auto;
    max-height: calc(100vh - clamp(1rem, 5vw, 2rem));
    border-radius: .9rem;
    border: 1px solid var(--border);
    padding: clamp(.85rem, 4vw, 1.25rem);
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.35);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .modal__dialog--sm {
    width: min(100vw - clamp(1rem, 6vw, 2rem), 360px);
  }
}
.barber-modal__header {
  display: flex;
  align-items: center;
  gap: .9rem;
  flex-wrap: wrap;
}
.barber-modal__avatar-button {
  border: none;
  background: transparent;
  padding: 0;
  display: inline-flex;
  cursor: pointer;
  border-radius: 999px;
}
.barber-modal__avatar-button:focus-visible {
  outline: 2px solid rgba(139, 92, 246, 0.5);
  outline-offset: 4px;
  border-radius: 999px;
}
.barber-modal__avatar {
  width: 96px;
  height: 96px;
}
.barber-modal__avatar .barber-card__avatar-inner {
  font-size: 1.6rem;
}
.barber-modal__titles {
  display: grid;
  gap: .25rem;
  min-width: 0;
}
.barber-modal__titles h2 {
  margin: 0;
  font-size: 1.3rem;
}
.barber-modal__turns {
  margin: 0;
  color: var(--muted);
  font-size: .92rem;
}
.barber-modal__body {
  display: grid;
  gap: .85rem;
}
.barber-modal__form {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: .7rem;
}
.barber-modal__form label { display: grid; gap: .35rem; font-size: .95rem; color: var(--muted); min-width: 0; }
.barber-modal__form input,
.barber-modal__form select {
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(148, 163, 184, 0.3);
  border-radius: .6rem;
  padding: .5rem .7rem;
  color: var(--text);
  font-size: .96rem;
  width: 100%;
  min-width: 0;
}
.barber-modal__form input:focus,
.barber-modal__form select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.25); }
.barber-modal__description {
  margin: 0;
  color: var(--muted);
  font-size: .92rem;
}
.barber-modal__alert {
  margin: 0;
  color: #f87171;
  font-size: .9rem;
  font-weight: 600;
}
.barber-modal__slots {
  display: flex;
  flex-wrap: wrap;
  gap: .6rem;
}
.barber-modal__empty {
  margin: 0;
  color: var(--muted);
  font-size: .94rem;
}
.barber-modal__cta {
  width: 100%;
  margin-top: .4rem;
}
@media (max-width: 560px) {
  .modal__dialog--barber {
    width: min(420px, 92vw);
    gap: .85rem;
    padding: clamp(1rem, 4vw, 1.35rem);
  }
  .barber-modal__avatar {
    width: 82px;
    height: 82px;
  }
  .barber-modal__titles h2 {
    font-size: 1.2rem;
  }
  .barber-modal__body {
    gap: .75rem;
  }
  .barber-modal__form {
    gap: .6rem;
  }
}
@media (max-width: 420px) {
  .barber-modal__header {
    justify-content: center;
    text-align: center;
  }
  .barber-modal__titles {
    justify-items: center;
  }
  .barber-modal__form {
    grid-template-columns: 1fr;
  }
}
.barber-modal__photo-overlay {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  background: rgba(15, 17, 21, 0.88);
  border-radius: inherit;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity .18s ease;
  padding: 1.5rem;
  z-index: 2;
}
.barber-modal__photo-overlay.is-visible {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}
.barber-modal__photo-frame {
  position: relative;
  display: grid;
  gap: 1rem;
  justify-items: center;
  max-width: min(420px, 94vw);
}
.barber-modal__photo-close {
  position: absolute;
  top: -.6rem;
  right: -.6rem;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: none;
  background: rgba(15, 23, 42, 0.85);
  color: var(--text);
  font-size: 1.75rem;
  line-height: 1;
  font-family: inherit;
  cursor: pointer;
  display: grid;
  place-items: center;
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
}
.barber-modal__photo-close:hover {
  background: rgba(30, 41, 59, 0.95);
}
.barber-modal__photo-preview {
  width: clamp(220px, 40vw, 280px);
  aspect-ratio: 1 / 1;
  position: relative;
  display: grid;
  place-items: center;
}
.barber-modal__photo-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 24px;
  box-shadow: 0 24px 48px rgba(0, 0, 0, 0.4);
}
.barber-modal__photo-img[hidden] {
  display: none;
}
.barber-modal__photo-fallback {
  width: 100%;
  height: 100%;
  border-radius: 24px;
  padding: 16px;
  display: grid;
  place-items: center;
}
.barber-modal__photo-fallback[hidden] {
  display: none;
}
.barber-modal__photo-fallback .barber-card__avatar-inner {
  border-radius: 18px;
  font-size: 2.4rem;
}
.barber-modal__photo-meta {
  text-align: center;
  display: grid;
  gap: .25rem;
}
.barber-modal__photo-meta h3 {
  margin: 0;
  font-size: 1.35rem;
}
.barber-modal__photo-meta p {
  margin: 0;
  color: var(--muted);
  font-size: .95rem;
}
.modal.is-visible .modal__dialog {
  opacity: 1;
  animation: modal-jelly-in .45s ease-out both;
}
.modal.is-visible.is-closing .modal__dialog {
  animation: modal-jelly-out .35s ease-in forwards;
}
.modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}
.modal__header h2 {
  margin: 0;
  font-size: 1.25rem;
}
.modal__close {
  background: transparent;
  border: none;
  color: var(--muted);
  font-size: 1.5rem;
  cursor: pointer;
}
.modal__close:hover {
  color: var(--text);
}
.modal__body {
  display: grid;
  gap: 1rem;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.legal-modal {
  gap: 1.4rem;
  padding-right: .2rem;
}
.legal-modal__section {
  display: grid;
  gap: .5rem;
  padding: .2rem 0;
}
.legal-modal__section + .legal-modal__section {
  border-top: 1px solid rgba(148, 163, 184, 0.18);
  padding-top: 1rem;
}
.legal-modal__title {
  margin: 0;
  font-size: 1.05rem;
  color: var(--text);
}
.legal-modal__text {
  color: var(--muted);
  font-size: .95rem;
  line-height: 1.6;
}

/* Minimal slots (dark) */
.slot-btn {
  appearance: none;
  border: 1px solid rgba(148, 163, 184, 0.28);
  background: rgba(148, 163, 184, 0.12);
  color: var(--text);
  font: inherit;
  font-weight: 600;
  font-size: .9rem;
  padding: .45rem .6rem;
  border-radius: .55rem;
  cursor: pointer;
  transition: background .12s ease, border-color .12s ease, box-shadow .12s ease, transform .12s ease;
}
.slot-btn:hover {
  background: rgba(148, 163, 184, 0.18);
  border-color: rgba(148, 163, 184, 0.4);
  transform: translateY(-1px);
}
.slot-btn.is-selected {
  background: var(--success);
  border-color: var(--success-dark);
  color: #052e16;
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.22);
}
.slot-btn:disabled {
  opacity: .55;
  cursor: not-allowed;
}
.payment-options {
  display: grid;
  gap: .8rem;
}
.payment-btn {
  width: 100%;
  padding: .75rem 1rem;
  border-radius: .8rem;
  border: 1px solid rgba(148, 163, 184, 0.3);
  background: rgba(148, 163, 184, 0.12);
  color: var(--text);
  font-weight: 600;
  cursor: pointer;
  transition: transform .12s ease, box-shadow .12s ease, background .12s ease, border-color .12s ease;
}
.payment-btn:hover {
  transform: translateY(-1px);
  border-color: var(--success);
  background: rgba(34, 197, 94, 0.12);
  box-shadow: 0 12px 28px rgba(34, 197, 94, 0.16);
}

@media (max-width: 720px) {
  .schedule-controls label {
    width: 100%;
  }
  .schedule-controls input,
  .schedule-controls select {
    width: 100%;
  }
  .schedule-card {
    padding: 1rem;
  }
}
.modal__header-text {
  display: grid;
  gap: .2rem;
}
.modal__eyebrow {
  margin: 0;
  font-size: .85rem;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--muted);
}
.modal__header h2 span {
  color: var(--text);
}

.client-form fieldset {
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: .8rem;
  padding: 1rem;
  display: grid;
  gap: .8rem;
}
.client-form legend {
  padding: 0 .4rem;
  font-weight: 600;
  color: var(--text);
}
.client-form label {
  display: grid;
  gap: .4rem;
  font-size: .95rem;
}
.client-form input {
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(148, 163, 184, 0.3);
  border-radius: .6rem;
  padding: .55rem .75rem;
  color: var(--text);
  font-size: 1rem;
}
.client-form input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.25);
}

.client-form__actions {
  display: grid;
  gap: .8rem;
  margin-top: 1rem;
}
.client-form__link {
  background: transparent;
  border: none;
  color: var(--accent);
  font-weight: 600;
  text-align: left;
  padding: 0;
  cursor: pointer;
}
.client-form__link:hover {
  text-decoration: underline;
}
.client-form__submit {
  background: var(--success);
  color: #052e16;
  border: 1px solid var(--success-dark);
  border-radius: .8rem;
  padding: .7rem 1.2rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform .12s ease, box-shadow .12s ease;
}
.client-form__submit:hover {
  transform: translateY(-1px);
  box-shadow: 0 12px 28px rgba(34, 197, 94, 0.22);
}
.login-modal__message {
  margin: 0 0 1rem;
  padding: .75rem 1rem;
  border-radius: .7rem;
  background: rgba(249, 115, 22, 0.15);
  border: 1px solid rgba(249, 115, 22, 0.45);
  color: #fed7aa;
  font-weight: 600;
}
.login-form {
  display: grid;
  gap: .9rem;
}
.login-form label {
  display: grid;
  gap: .4rem;
  font-size: .95rem;
}
.login-form input {
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(148, 163, 184, 0.3);
  border-radius: .6rem;
  padding: .55rem .75rem;
  color: var(--text);
  font-size: 1rem;
}
.login-form input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.25);
}
.login-form__submit {
  background: var(--accent);
  border: 1px solid var(--accent-600);
  border-radius: .8rem;
  padding: .7rem 1.2rem;
  color: #0f172a;
  font-weight: 700;
  cursor: pointer;
  transition: transform .12s ease, box-shadow .12s ease;
}
.login-form__submit:hover {
  transform: translateY(-1px);
  box-shadow: 0 12px 28px rgba(140, 131, 253, 0.3);
}
.header-right {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.header-right .cart-pill { order: 0; }
.header-right .user-menu { order: 1; }
.cart-pill {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px; height: 36px;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.08);
  border: 1px solid rgba(148, 163, 184, 0.35);
  color: var(--text);
  cursor: pointer;
  transition: box-shadow .15s ease, border-color .15s ease;
}
.cart-pill:hover { border-color: rgba(239, 68, 68, 0.75); }
.cart-pill__badge {
  position: absolute;
  top: -6px; right: -6px;
  min-width: 18px; height: 18px;
  padding: 0 4px;
  border-radius: 999px;
  background: #ef4444; /* red-500 */
  color: white;
  font-size: 12px;
  line-height: 18px;
  text-align: center;
  font-weight: 700;
}
.user-pill {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  padding: .45rem .75rem;
  border-radius: 999px;
  background: rgba(59, 130, 246, 0.12);
  border: 1px solid rgba(59, 130, 246, 0.35);
  color: var(--text);
  font-size: .95rem;
  cursor: pointer;
  border-width: 1px;
  font: inherit;
  transition: box-shadow .15s ease, border-color .15s ease;
}
.user-pill:hover { border-color: rgba(139, 92, 246, 0.6); }
.user-pill:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.35);
}
.user-pill__greeting {
  color: var(--muted);
}
.user-pill__name {
  font-weight: 600;
}
.avatar-trigger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  padding: 0;
  border: none;
  border-radius: 999px;
  position: relative;
  background: transparent;
  cursor: pointer;
}
.avatar-trigger:focus-visible {
  outline: 2px solid rgba(139, 92, 246, 0.55);
  outline-offset: 2px;
}
.avatar-trigger:hover .avatar {
  border-color: rgba(139, 92, 246, 0.6);
}
.avatar-trigger__badge {
  position: absolute;
  top: -4px;
  right: -4px;
  margin: 0;
}
/* Inline alert badge for counts */
.pill-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 18px;
  height: 18px;
  padding: 0 6px;
  margin-left: .35rem;
  border-radius: 999px;
  background: #ef4444;
  color: #fff;
  font-size: 12px;
  line-height: 18px;
  font-weight: 700;
}
/* Unified avatar circle */
.avatar {
  width: 36px;
  height: 36px;
  border-radius: 999px;
  border: 1px solid rgba(148, 163, 184, 0.45);
  display: grid;
  place-items: center;
  overflow: hidden;
  background: linear-gradient(180deg, #1f2432, #11151e);
}
.avatar--header { width: 36px; height: 36px; }
.avatar__img { width: 100%; height: 100%; object-fit: cover; display: block; }
.avatar__img[hidden] { display: none; }
.avatar__initials {
  font-weight: 700;
  font-size: 1rem;
  color: #f8fafc;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}
.header-login {
  white-space: nowrap;
}
.user-menu {
  position: relative;
  display: inline-flex;
}
.user-menu-panel {
  position: absolute;
  top: calc(100% + .6rem);
  right: 0;
  display: grid;
  gap: .2rem;
  padding: .6rem;
  width: 180px;
  background: var(--panel);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: .9rem;
  box-shadow: 0 18px 40px rgba(15, 23, 42, 0.4);
  z-index: 20;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(-6px) scale(0.9);
  transform-origin: top right;
  transition: opacity .18s ease, transform .2s ease, visibility 0s linear .2s;
}
.user-menu-panel.is-open {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateY(0) scale(1);
  transition-delay: 0s, 0s, 0s;
  animation: user-menu-jelly .45s ease-out both;
}
.user-menu-item {
  width: 100%;
  background: transparent;
  border: none;
  color: var(--text);
  text-align: left;
  font-size: .95rem;
  padding: .45rem .55rem;
  border-radius: .6rem;
  cursor: pointer;
  transition: background .15s ease, color .15s ease;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.user-menu-item:hover,
.user-menu-item:focus {
  background: rgba(139, 92, 246, 0.15);
  outline: none;
}
.user-menu-item__content {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  color: inherit;
}
.user-menu-item__content i {
  font-size: 1.15rem;
}
.user-menu-item--danger {
  color: #f87171;
}
.user-menu-item--danger:hover,
.user-menu-item--danger:focus {
  background: rgba(239, 68, 68, 0.16);
  color: #fecaca;
}
.user-menu-panel::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: radial-gradient(circle at top, rgba(139, 92, 246, 0.08), transparent 70%);
  opacity: 0;
  transition: opacity .3s ease;
  pointer-events: none;
}
.user-menu-panel.is-open::before {
  opacity: 1;
}
@keyframes modal-jelly-in {
  0% {
    transform: translateY(-20px) scale(0.78, 0.65);
    opacity: 0;
  }
  45% {
    transform: translateY(0) scale(1.07, 0.95);
    opacity: 1;
  }
  65% {
    transform: translateY(0) scale(0.95, 1.04);
  }
  85% {
    transform: translateY(0) scale(1.02, 0.98);
  }
  100% {
    transform: translateY(0) scale(1, 1);
    opacity: 1;
  }
}
@keyframes modal-jelly-out {
  0% {
    transform: translateY(0) scale(1, 1);
    opacity: 1;
  }
  35% {
    transform: translateY(6px) scale(0.95, 1.04);
  }
  100% {
    transform: translateY(26px) scale(0.78, 0.6);
    opacity: 0;
  }
}
@keyframes user-menu-jelly {
  0% {
    transform: translateY(-8px) scale(0.82, 0.7);
  }
  40% {
    transform: translateY(0) scale(1.06, 0.95);
  }
  60% {
    transform: translateY(0) scale(0.96, 1.05);
  }
  80% {
    transform: translateY(0) scale(1.02, 0.99);
  }
  100% {
    transform: translateY(0) scale(1, 1);
  }
}
/* App dock styles (dark theme) */
.app-section{display:none;}
.app-section.is-active{display:block;}
.app-dock{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(520px,calc(100% - 32px));z-index:999;background:rgba(12,15,24,.92);border:1px solid rgba(148,163,184,.2);border-radius:999px 999px 0 0;display:grid;grid-auto-flow:column;gap:.3rem;padding:.6rem .5rem calc(.6rem + env(safe-area-inset-bottom,0px));box-shadow:0 -5px 30px rgba(5,7,14,.45);backdrop-filter:blur(12px);overflow:hidden;} 
.app-dock__btn{border:0;background:transparent;color:var(--muted);font-weight:600;display:flex;flex-direction:column;align-items:center;gap:.05rem;padding:.32rem .35rem;border-radius:.7rem;cursor:pointer;font-size:.78rem;transition:background .2s ease, color .2s ease;} 
.app-dock__btn i{font-size:1.05rem;} 
.app-dock__btn.is-active{background:rgba(139,92,246,.18);color:#fff;padding:.32rem .65rem;border-radius:.65rem;} 
.app-dock__btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}
.site-public main{padding-bottom:min(240px,30vh);}

.info-legal{border-top:1px solid var(--border);margin-top:1rem;padding-top:1.2rem;display:grid;gap:.9rem;}
.info-legal h3{margin:0;}
.info-legal article{border:1px solid rgba(148,163,184,.25);border-radius:.9rem;padding:1rem;background:rgba(15,23,42,.45);display:grid;gap:.4rem;}
.info-legal article h4{margin:0;font-size:1rem;}
.info-legal article div{color:var(--muted);font-size:.95rem;line-height:1.5;}
.info-card{background:var(--panel);border:1px solid var(--border);border-radius:1.25rem;padding:1.6rem;display:grid;gap:1.2rem;background-image:linear-gradient(135deg, rgba(139,92,246,0.08), transparent 60%),linear-gradient(315deg, rgba(56,189,248,0.08), transparent 55%);box-shadow:0 25px 65px rgba(5,8,20,0.35);position:relative;overflow:hidden;}
.info-card::after{content:"";position:absolute;inset:10px;border-radius:inherit;border:1px solid rgba(255,255,255,0.05);pointer-events:none;}
.info-card > *{position:relative;}
.info-eyebrow{text-transform:uppercase;letter-spacing:.25em;font-size:.78rem;color:rgba(148,163,184,.85);margin:0;}
.info-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.2rem;margin:0;}
.info-grid dt{font-size:.85rem;text-transform:uppercase;letter-spacing:.11em;color:rgba(148,163,184,.85);margin:0 0 .2rem;}
.info-grid dd{margin:0;font-size:1.05rem;color:var(--text);}
.info-grid a{color:var(--accent);font-weight:600;text-decoration:none;}
.info-grid a:hover{text-decoration:underline;}
.info-socials{display:flex;flex-wrap:wrap;gap:.6rem;}
.info-socials a{display:inline-flex;align-items:center;gap:.3rem;padding:.45rem .75rem;border-radius:.8rem;border:1px solid rgba(148,163,184,.25);background:rgba(15,23,42,.55);color:var(--text);text-decoration:none;font-size:.9rem;}
.info-socials a:hover{border-color:var(--accent);color:var(--accent);}
.info-links{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;justify-content:space-between;}
.info-legal-btn{border:1px solid rgba(148,163,184,.35);background:rgba(139,92,246,0.15);color:#e0e7ff;border-radius:.8rem;padding:.5rem .9rem;font-weight:600;display:inline-flex;align-items:center;gap:.4rem;cursor:pointer;transition:all .2s ease;}
.info-legal-btn i{font-size:1.1rem;}
.info-legal-btn:hover{background:rgba(139,92,246,0.25);border-color:rgba(139,92,246,0.5);}
.admin-share-link{display:flex;flex-direction:column;gap:.35rem;margin-bottom:1rem;}
.admin-share-link__label{margin:0;font-size:.85rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);}
.admin-share-link__btn{border:1px solid rgba(139,92,246,.35);background:rgba(15,23,42,.75);color:#f8fafc;border-radius:1rem;padding:.55rem 1rem;display:inline-flex;align-items:center;gap:.55rem;font-weight:600;cursor:pointer;transition:all .2s ease;box-shadow:0 12px 30px rgba(8,12,24,.35);}
.admin-share-link__btn span{font-size:1rem;letter-spacing:.02em;}
.admin-share-link__btn i{font-size:1.05rem;}
.admin-share-link__btn:hover{background:rgba(99,102,241,.25);border-color:rgba(99,102,241,.55);box-shadow:0 16px 38px rgba(79,70,229,.35);}
.admin-share-link__hint{color:var(--muted);margin:0;font-size:.85rem;opacity:0;transition:opacity .2s ease,color .2s ease;}
.admin-share-link__hint.is-visible{opacity:1;}
.admin-share-link__hint.is-success{color:#34d399;}
.admin-bottomnav__item{position:relative;}
.admin-bottomnav__badge{position:absolute;top:6px;right:12px;min-width:18px;height:18px;padding:0 5px;border-radius:999px;background:#ef4444;color:#fff;font-size:.7rem;font-weight:700;line-height:18px;display:flex;align-items:center;justify-content:center;pointer-events:none;box-shadow:0 8px 18px rgba(239,68,68,.35);}

@media (max-width:640px){
  .admin-bottomnav__badge{min-width:22px;height:22px;font-size:.85rem;line-height:22px;top:3px;right:8px;}
}


.admin-bottomnav__badge[hidden]{display:none!important;}


.admin-bottomnav__item.has-alert i{animation:admin-pulse 1.1s ease-in-out infinite;}
@keyframes admin-pulse{
  0%{transform:scale(1);filter:drop-shadow(0 0 0 rgba(239,68,68,0));}
  50%{transform:scale(1.15);filter:drop-shadow(0 0 12px rgba(239,68,68,.45));}
  100%{transform:scale(1);filter:drop-shadow(0 0 0 rgba(239,68,68,0));}
}

.ios-install-prompt{
  position:fixed;
  left:50%;
  bottom:16px;
  transform:translate(-50%,20px);
  width:min(420px,calc(100% - 32px));
  z-index:9999;
  opacity:0;
  pointer-events:none;
  transition:opacity .3s ease, transform .3s ease;
}
.ios-install-prompt.is-visible{
  opacity:1;
  transform:translate(-50%,0);
  pointer-events:auto;
}
.ios-install-prompt__body{
  background:rgba(2,6,23,.96);
  border:1px solid rgba(248,250,252,.15);
  border-radius:1.25rem;
  padding:1.15rem 1.4rem;
  box-shadow:0 24px 55px rgba(2,6,23,.65);
  display:grid;
  gap:.85rem;
}
.ios-install-prompt__header{
  display:flex;
  gap:.75rem;
  align-items:flex-start;
}
.ios-install-prompt__header i{
  font-size:1.8rem;
  color:#38bdf8;
}
.ios-install-prompt__title{
  margin:0;
  font-size:1rem;
  font-weight:700;
}
.ios-install-prompt__subtitle{
  margin:.15rem 0 0;
  font-size:.88rem;
  color:rgba(248,250,252,.7);
}
.ios-install-steps{
  list-style:none;
  margin:0;
  padding:0;
  display:grid;
  gap:.35rem;
  font-size:.88rem;
  color:rgba(248,250,252,.85);
}
.ios-install-steps__icon{
  display:inline-flex;
  align-items:center;
  gap:.25rem;
  border-radius:.65rem;
  border:1px solid rgba(248,250,252,.25);
  padding:.05rem .6rem;
  font-size:.8rem;
  background:rgba(15,23,42,.8);
}
.ios-install-prompt__cta{
  justify-self:end;
  width:100%;
}

