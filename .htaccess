# Agenduy - Raíz
Options -Indexes
ServerSignature Off

# Activar mod_rewrite para el router genérico
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sitemap y páginas SEO
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^categorias/([a-z0-9-]+)/?$ categorias/index.php?c=$1 [L,QSA]
    RewriteRule ^categorias/?$ categorias/index.php [L,QSA]
    RewriteRule ^ubicaciones/([a-z0-9-]+)/?$ ubicaciones/index.php?l=$1 [L,QSA]
    RewriteRule ^ubicaciones/?$ ubicaciones/index.php [L,QSA]

    # Si la URL es un archivo real (CSS, JS, imágenes), servirlo tal cual
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Si la URL es un directorio real (admin/, src/, public/, etc.),
    # Apache sirve su index.php automáticamente
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Panel admin del negocio sin carpeta tenant → panel central compartido
    RewriteRule ^([a-z0-9][a-z0-9-]*)/private/dashboard/admin/index\.php$ admin/commerce_panel.php?slug=$1 [L,QSA]
    RewriteRule ^([a-z0-9][a-z0-9-]*)/private/dashboard/admin/?$ admin/commerce_panel.php?slug=$1 [L,QSA]

    # Si NO es archivo ni directorio (ej: /agenduy.uy/la-barberia/ sin carpeta física),
    # enrutar al index.php raíz que detecta el slug y renderiza el comercio
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# Bloquear listados de directorios y archivos sensibles
<FilesMatch "\.(sqlite|sqlite3|db|sqlite-journal|sqlite-shm|sqlite-wal|env|ini|log|bak|sql)$">
    Require all denied
</FilesMatch>

# Bloquear acceso directo a la "BD" vieja y a los secretos
<Files "database.php">
    Require all denied
</Files>
<Files "mail_secret.php">
    Require all denied
</Files>
<Files "composer.json">
    Require all denied
</Files>
<Files "composer.lock">
    Require all denied
</Files>

# Headers de seguridad
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
