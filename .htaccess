# Agenduy - Raíz
Options -Indexes
ServerSignature Off

# Activar mod_rewrite para el router genérico
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sitemap y páginas SEO
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^categorias/([a-z0-9-]+)/?$ categorias/index.php?c=$1 [L,QSA]
    RewriteRule ^categorias/?$ categorias/index.php [L,QSA]
    RewriteRule ^ubicaciones/([a-z0-9-]+)/?$ ubicaciones/index.php?l=$1 [L,QSA]
    RewriteRule ^ubicaciones/?$ ubicaciones/index.php [L,QSA]

    # Panel admin del negocio: usar siempre el panel central compartido,
    # incluso si existe una carpeta tenant antigua con su propio dashboard.
    RewriteRule ^(?!template/)([a-z0-9][a-z0-9-]*)/private/dashboard/admin/index\.php$ admin/commerce_panel.php?slug=$1 [L,QSA]
    RewriteRule ^(?!template/)([a-z0-9][a-z0-9-]*)/private/dashboard/admin/?$ admin/commerce_panel.php?slug=$1 [L,QSA]

    # Si la URL es un archivo real (CSS, JS, imágenes), servirlo tal cual
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Si la URL es un directorio real (admin/, src/, public/, etc.),
    # Apache sirve su index.php automáticamente
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Assets/API del panel central bajo URL del comercio (si no hay carpeta tenant legacy)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9][a-z0-9-]*)/private/dashboard/(.*)$ template/private/dashboard/$2 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/index\.php [NC]
    RewriteRule ^([a-z0-9][a-z0-9-]*)/src/(.*)$ template/src/$2 [L]

    # Acceso directo al template compartido (normalizar Admin/index)
    RewriteRule ^template/private/dashboard/(?i)admin/index/?$ template/private/dashboard/admin/index.php [L,QSA]

    # Si NO es archivo ni directorio (ej: /agenduy.uy/la-barberia/ sin carpeta física),
    # enrutar al index.php raíz que detecta el slug y renderiza el comercio
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# Bloquear listados de directorios y archivos sensibles
<FilesMatch "\.(sqlite|sqlite3|db|sqlite-journal|sqlite-shm|sqlite-wal|env|ini|log|bak|sql)$">
    Require all denied
</FilesMatch>

# Bloquear acceso directo a la "BD" vieja y a los secretos
<Files "database.php">
    Require all denied
</Files>
<Files "mail_secret.php">
    Require all denied
</Files>
<Files "composer.json">
    Require all denied
</Files>
<Files "composer.lock">
    Require all denied
</Files>

# Headers de seguridad
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Cache para assets estaticos. No aplica a HTML/PHP ni APIs.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType text/javascript "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|mjs|png|jpe?g|gif|webp|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <Files "sw.js">
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    </Files>
</IfModule>
