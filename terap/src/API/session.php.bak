<?php
// Asegurarnos de que los errores de PHP no se muestren en la respuesta JSON
error_reporting(E_ALL);
ini_set('display_errors', 0);

// Asegurarnos que las sesiones están habilitadas
if (session_status() === PHP_SESSION_NONE) {
    // Configuración estricta de sesiones
    ini_set('session.cookie_httponly', 1);
    ini_set('session.use_only_cookies', 1);
    ini_set('session.use_strict_mode', 1);
    ini_set('session.cookie_secure', 0); // Cambiar a 1 si usas HTTPS
    ini_set('session.cookie_lifetime', 86400); // 24 horas
    ini_set('session.gc_maxlifetime', 86400); // 24 horas
    ini_set('session.gc_probability', 1);
    ini_set('session.gc_divisor', 100); // 1% probabilidad de limpieza
    
    // Asegurar que el directorio de sesiones existe y es escribible
    $sessionPath = 'c:/xampp/tmp/sessions';
    if (!is_dir($sessionPath)) {
        mkdir($sessionPath, 0777, true);
    }
    ini_set('session.save_path', $sessionPath);
    
    // Configuración de cookies
    $cookiePath = '/';
    session_set_cookie_params([
        'lifetime' => 86400,
        'path' => $cookiePath,
        'domain' => '',
        'secure' => false, // Cambiar a true si usas HTTPS
        'httponly' => true,
        'samesite' => 'Lax'
    ]);
    
    // Iniciar la sesión con nombre específico
    session_name('agendaSession');
    session_start();
}

// Configurar timezone y cargar dependencias
date_default_timezone_set('America/Montevideo');
require_once __DIR__ . '/Autoload.php';

// Configurar headers
header('Content-Type: application/json; charset=utf-8');

$method = $_SERVER['REQUEST_METHOD'] ?? 'GET';
$inputRaw = file_get_contents('php://input');
$input = [];
if ($inputRaw) {
    $decoded = json_decode($inputRaw, true);
    if (json_last_error() === JSON_ERROR_NONE && is_array($decoded)) {
        $input = $decoded;
    }
}

$params = array_merge($_GET, $_POST, $input);
$action = strtolower((string)($params['action'] ?? 'status'));

function response($data, int $code = 200) {
    // Limpiar cualquier salida anterior y buffers
    while (ob_get_level()) {
        ob_end_clean();
    }
    
    // Establecer headers correctos
    header('Content-Type: application/json; charset=utf-8');
    header('Cache-Control: no-cache, must-revalidate');
    http_response_code($code);
    
    // Codificar respuesta y manejar errores
    $json = json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    if ($json === false) {
        error_log('Error codificando JSON: ' . json_last_error_msg());
        http_response_code(500);
        echo json_encode([
            'ok' => false,
            'error' => 'Error interno del servidor',
            'message' => 'Error codificando la respuesta'
        ]);
    } else {
        echo $json;
    }
    exit();
    $json = json_encode($data);
    if ($json === false) {
        error_log('Error codificando respuesta JSON: ' . json_last_error_msg());
        echo json_encode(['ok' => false, 'error' => 'Error interno del servidor']);
    } else {
        echo $json;
    }
    exit;
}

function clientesByCedula(string $cedula) {
    $clientes = AutoloadDB::all('clientes');
    $needle = strtolower(trim($cedula));
    foreach ($clientes as $cliente) {
        if (!isset($cliente['Cedula'])) continue;
        if (strtolower(trim((string)$cliente['Cedula'])) === $needle) {
            return $cliente;
        }
    }
    return null;
}

function reservasByClienteId($clienteId): array {
    if ($clienteId === null || $clienteId === '') {
        return [];
    }
    try {
        $reservas = AutoloadDB::all('reservas');
    } catch (Throwable $e) {
        return [];
    }
    $matches = [];
    foreach ($reservas as $reserva) {
        if ((string)($reserva['ID_Cliente'] ?? '') === (string)$clienteId) {
            $matches[] = $reserva;
        }
    }
    return $matches;
}

function attachReservasToSession(array $cliente): array {
    $clienteId = $cliente['ID_Cliente'] ?? null;
    $reservas = reservasByClienteId($clienteId);
    $sessionData = [
        'nombre' => (string)($cliente['Nombre'] ?? ''),
        'cedula' => (string)($cliente['Cedula'] ?? ''),
        'telefono' => (string)($cliente['Telefono'] ?? ''),
        'email' => (string)($cliente['Email'] ?? ''),
        'perfil' => (string)($cliente['Perfil'] ?? ''),
        'cliente_id' => $clienteId,
        'reservas' => $reservas,
    ];
    return $sessionData;
}

function verificarCredencialesBarbero($barberoData, $password) {
    error_log('[Verificación] Iniciando verificación de credenciales');
    
    if (empty($barberoData) || empty($password)) {
        error_log('[Verificación] Error: Datos incompletos');
        return false;
    }

    try {
        $barberos = AutoloadDB::all('barberos');
        if (!is_array($barberos)) {
            error_log('[Verificación] Error: No se pudo obtener la lista de barberos');
            return false;
        }

        error_log('[Verificación] Buscando barbero con ID: ' . ($barberoData['ID_Barber'] ?? 'no ID'));
        
        foreach ($barberos as $barbero) {
            if ((string)($barbero['ID_Barber'] ?? '') === (string)($barberoData['ID_Barber'] ?? '')) {
                error_log('[Verificación] Barbero encontrado, verificando contraseña');
                
                // Verificación de contraseña
                $credencialesValidas = $barbero['Password'] === $password;
                
                if ($credencialesValidas) {
                    error_log('[Verificación] Credenciales válidas, actualizando datos');
                    
                    // Asegurarnos de que tenemos todos los campos necesarios
                    $camposRequeridos = ['ID_Barber', 'Nombre', 'Apellido', 'Cedula', 'Rol', 'Disponibilidad'];
                    foreach ($camposRequeridos as $campo) {
                        if (!isset($barbero[$campo])) {
                            error_log("[Verificación] Error: Falta el campo $campo en los datos del barbero");
                            return false;
                        }
                        // Actualizar el campo en los datos del barbero
                        $barberoData[$campo] = $barbero[$campo];
                    }
                    
                    return $barberoData;
                }
                
                error_log('[Verificación] Contraseña inválida');
                return false;
            }
        }
        
        error_log('[Verificación] Barbero no encontrado en la base de datos');
        return false;
        
    } catch (Throwable $e) {
        error_log('[Verificación] Error: ' . $e->getMessage());
        return false;
    }
}

function iniciarSesionBarbero($barberoData) {
    error_log('[Sesión] Iniciando proceso de sesión de barbero');
    
    try {
        // Verificar campos requeridos
        $camposRequeridos = ['ID_Barber', 'Nombre', 'Apellido', 'Cedula', 'Rol', 'Disponibilidad'];
        foreach ($camposRequeridos as $campo) {
            if (!isset($barberoData[$campo])) {
                error_log("[Sesión] Error: Falta el campo requerido '$campo'");
                return false;
            }
        }

        // Regenerar el ID de sesión por seguridad
        session_regenerate_id(true);
        
        // Limpiar la sesión actual
        $_SESSION = array();
        
        // Inicializar los datos de la sesión del barbero
        $now = time();
        $_SESSION['barbero'] = [
            'ID_Barber' => $barberoData['ID_Barber'],
            'Nombre' => $barberoData['Nombre'],
            'Apellido' => $barberoData['Apellido'],
            'Cedula' => $barberoData['Cedula'],
            'Rol' => $barberoData['Rol'],
            'Disponibilidad' => $barberoData['Disponibilidad'],
            'Status' => 'Online',
            'started_at' => date('Y-m-d H:i:s', $now),
            'expires_at' => $now + 86400 // 24 horas
        ];

        // Forzar la escritura de la sesión
        session_write_close();
        
        // Reabrir la sesión
        session_start();
        
        // Verificar que los datos se guardaron correctamente
        if (empty($_SESSION['barbero'])) {
            error_log('[Sesión] Error: Falló al guardar datos de sesión');
            return false;
        }

        error_log('[Sesión] Sesión iniciada exitosamente');
        error_log('[Sesión] ID de Barbero: ' . $_SESSION['barbero']['ID_Barber']);
        error_log('[Sesión] Nombre completo: ' . $_SESSION['barbero']['Nombre'] . ' ' . $_SESSION['barbero']['Apellido']);
        error_log('[Sesión] Rol: ' . $_SESSION['barbero']['Rol']);
        
        return true;
    } catch (Throwable $e) {
        error_log('[Sesión] Error crítico: ' . $e->getMessage());
        return false;
    }
}

// Manejador de rutas
switch ($action) {
    case 'barber_login':
        try {
            error_log('[Barbero Login] Iniciando proceso de login');
            
            $password = trim((string)($params['password'] ?? ''));
            $barberData = $params['barber_data'] ?? null;

            if (empty($barberData) || empty($password)) {
                error_log('[Barbero Login] Error: Datos incompletos');
                throw new Exception('Datos incompletos');
            }

            // Verificar credenciales y obtener datos actualizados
            $barberoVerificado = verificarCredencialesBarbero($barberData, $password);
            if (!$barberoVerificado) {
                error_log('[Barbero Login] Error: Credenciales inválidas');
                throw new Exception('Credenciales inválidas');
            }

            // Iniciar sesión con los datos verificados
            if (!iniciarSesionBarbero($barberoVerificado)) {
                error_log('[Barbero Login] Error: No se pudo iniciar la sesión');
                throw new Exception('Error al iniciar la sesión');
            }

            error_log('[Barbero Login] Éxito - Sesión iniciada correctamente');
            response(['ok' => true, 'data' => $barberoVerificado]);
        } catch (Exception $e) {
            error_log('[Barbero Login] Error: ' . $e->getMessage());
            response(['ok' => false, 'error' => $e->getMessage()], 401);
        }
        break;
            response(['ok' => true, 'data' => $_SESSION['barbero']]);

        } catch (Exception $e) {
            error_log('[Barbero Login] Error: ' . $e->getMessage());
            response(['ok' => false, 'error' => $e->getMessage()], 401);
        }
        break;

    case 'barber_logout':
        unset($_SESSION['barbero']);
        response(['ok' => true]);
        break;

    case 'start':
        $cedula = trim((string)($params['cedula'] ?? ''));
        if ($cedula === '') {
            response(['ok' => false, 'error' => 'Falta la cedula'], 400);
        }
        try {
            $cliente = clientesByCedula($cedula);
        } catch (Throwable $e) {
            response(['ok' => false, 'error' => 'No se pudo acceder a clientes'], 500);
        }
        if (!$cliente) {
            response(['ok' => false, 'error' => 'Cliente no encontrado'], 404);
        }
        $now = time();
        $sessionData = attachReservasToSession($cliente);
        $sessionData['started_at'] = date('Y-m-d H:i:s', $now);
        $sessionData['expires_at'] = $now + 86400;
        $_SESSION['cliente'] = $sessionData;
        response(['ok' => true, 'data' => $_SESSION['cliente']]);
        break;

    case 'logout':
        unset($_SESSION['cliente']);
        response(['ok' => true]);
        break;

    case 'status':
    default:
        try {
            error_log('[Status] Verificando estado de sesión');
            
            // Verificar sesión de barbero
            if (isset($_SESSION['barbero'])) {
                error_log('[Status] Encontrada sesión de barbero');
                
                if (isset($_SESSION['barbero']['expires_at']) && time() > (int)$_SESSION['barbero']['expires_at']) {
                    error_log('[Status] Sesión expirada');
                    unset($_SESSION['barbero']);
                    response(['ok' => false, 'data' => null, 'message' => 'Sesión expirada']);
                }
                
                error_log('[Status] Sesión válida. Datos: ' . json_encode($_SESSION['barbero']));
                response(['ok' => true, 'data' => $_SESSION['barbero']]);
            }
            
            // Verificar sesión de cliente
            if (isset($_SESSION['cliente'])) {
                if (isset($_SESSION['cliente']['expires_at']) && time() > (int)$_SESSION['cliente']['expires_at']) {
                    unset($_SESSION['cliente']);
                    response(['ok' => false, 'data' => null]);
                }
                // Actualizar reservas si es posible
                if (!empty($_SESSION['cliente']['cliente_id']) || !empty($_SESSION['cliente']['cedula'])) {
                    try {
                        $cliente = null;
                        if (!empty($_SESSION['cliente']['cliente_id'])) {
                            $allClientes = AutoloadDB::all('clientes');
                            foreach ($allClientes as $c) {
                                if ((string)($c['ID_Cliente'] ?? '') === (string)$_SESSION['cliente']['cliente_id']) {
                                    $cliente = $c;
                                    break;
                                }
                            }
                        }
                        if (!$cliente && !empty($_SESSION['cliente']['cedula'])) {
                            $cliente = clientesByCedula($_SESSION['cliente']['cedula']);
                        }
                        if ($cliente) {
                            $snapshot = attachReservasToSession($cliente);
                            $_SESSION['cliente'] = array_merge($_SESSION['cliente'], $snapshot);
                        }
                    } catch (Throwable $e) {
                        error_log('[Status] Error actualizando datos del cliente: ' . $e->getMessage());
                        // Ignorar errores de actualización, devolver datos existentes
                    }
                }
                response(['ok' => true, 'data' => $_SESSION['cliente']]);
            }
            
            response(['ok' => false, 'data' => null]);
        } catch (Throwable $e) {
            error_log('[Status] Error general: ' . $e->getMessage());
            response(['ok' => false, 'error' => 'Error interno del servidor', 'message' => $e->getMessage()]);
        }
